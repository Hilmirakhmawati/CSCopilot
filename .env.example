NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5
ANTHROPIC_MODEL=
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=
# Optional; local-only interval timer in minutes (0 = off, minimum 5). Leave empty:
# daily 02:00 WIB sync uses an external scheduler, see docs/notion-sync-schedule.md
CSCOPILOT_SYNC_INTERVAL_MINUTES=
# Secret header for external schedulers calling /api/cron/notion-sync
CRON_SECRET=
